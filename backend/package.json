{
  "name": "control-de-gastos-backend",
  "version": "1.0.0",
  "description": "API REST del proyecto académico Control de Gastos",
  "main": "dist/modules/server.js",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/modules/server.ts",
    "build": "tsc",
    "start": "node dist/modules/server.js",
    "db:init": "ts-node src/scripts/initDb.ts",
    "db:seed": "ts-node src/scripts/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.16.10",
    "@types/pg": "^8.11.10",
    "nodemon": "^3.1.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
